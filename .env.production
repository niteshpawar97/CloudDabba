# =========================================
# CloudDabba - Production Environment
# Copy this to backend/.env on VPS
# cp .env.production backend/.env
# =========================================

# App
NODE_ENV=production
PORT=6050
API_VERSION=v1

# Database (localhost since DB is on same VPS)
DATABASE_URL=postgresql://admin:Kamthi0786@@localhost:5432/clouddabba

# JWT (change this to a strong random string!)
JWT_SECRET=dev-secret-change-in-production-abc123
JWT_EXPIRE=7d

# Encryption (32-byte hex string for AES-256)
ENCRYPTION_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2

# Domain
BASE_DOMAIN=clouddabba.dev

# Docker (Linux native socket)
DOCKER_SOCKET=/var/run/docker.sock

# # NGINX
# NGINX_SITES_PATH=/home/learn-nodejs/htdocs/clouddabba/nginx/sites
# NGINX_RELOAD_CMD=echo nginx-reload-skipped

# NGINX
NGINX_SITES_PATH=/etc/nginx/sites-enabled
NGINX_RELOAD_CMD=sudo nginx -s reload


# Port range for deployed containers
PORT_RANGE_START=10000
PORT_RANGE_END=20000

# CORS
CORS_ORIGIN=http://clouddabba.dev,https://clouddabba.dev,http://129.159.16.65:6050

# Logging
LOG_LEVEL=info

# Database Provisioning (per-project databases)
PROVISION_DB_ADMIN_URL=postgresql://admin:Kamthi0786@@localhost:5432/postgres
PROVISION_DB_HOST=localhost
PROVISION_DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
