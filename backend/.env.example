# App
NODE_ENV=development
PORT=4000
API_VERSION=v1

# Database
DATABASE_URL=postgresql://clouddabba:password@localhost:5432/clouddabba

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Encryption (32-byte hex string for AES-256)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Domain
BASE_DOMAIN=clouddabba.dev

# Docker
DOCKER_SOCKET=/var/run/docker.sock

# NGINX
NGINX_SITES_PATH=/etc/nginx/sites-enabled
NGINX_RELOAD_CMD=nginx -s reload

# Port range for containers
PORT_RANGE_START=10000
PORT_RANGE_END=20000

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=debug

# Database Provisioning (per-project databases)
PROVISION_DB_ADMIN_URL=postgresql://clouddabba:password@localhost:5432/postgres
PROVISION_DB_HOST=localhost
PROVISION_DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MariaDB Provisioning
MARIADB_ADMIN_HOST=localhost
MARIADB_ADMIN_PORT=3306
MARIADB_ADMIN_USER=root
MARIADB_ADMIN_PASSWORD=
MARIADB_HOST=localhost
MARIADB_PORT=3306


