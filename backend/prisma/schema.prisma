generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique @db.VarChar(255)
  password           String    @db.VarChar(255)
  name               String    @db.VarChar(100)
  role               String    @default("user") @db.VarChar(20)
  // New public signups start unapproved; existing rows and admins default to approved
  approved           Boolean   @default(true)
  githubPatEncrypted String?   @map("github_pat_encrypted") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  projects           Project[]
  passwordChangedAt  DateTime? @map("password_changed_at")
  resetTokens        PasswordResetToken[]

  @@map("users")
}

enum ProjectType {
  NODE_BACKEND
  REACT_FRONTEND
  NEXTJS_APP
  STATIC_SITE
  FULLSTACK
  CUSTOM_DOCKERFILE
  DOCKER_COMPOSE
  ERPNEXT

  @@map("project_type")
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  FAILED
  BUILDING

  @@map("project_status")
}

model Project {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  name          String        @db.VarChar(100)
  repoUrl       String        @map("repo_url") @db.VarChar(500)
  subdomain     String        @unique @db.VarChar(63)
  projectType   ProjectType   @map("project_type")
  status        ProjectStatus @default(INACTIVE)
  branch        String        @default("main") @db.VarChar(100)
  envVars       Json?         @map("env_vars")
  autoDeploy    Boolean       @default(false) @map("auto_deploy")
  webhookSecret String?       @map("webhook_secret") @db.VarChar(64)
  // Per-project container resource limits (applied on deploy and live on save)
  memoryLimitMb Int           @default(512) @map("memory_limit_mb")
  cpuLimit      Float         @default(0.5) @map("cpu_limit")
  customDomain  String?       @unique @map("custom_domain") @db.VarChar(255)
  domainVerified Boolean      @default(false) @map("domain_verified")
  // Database provisioning
  dbEnabled       Boolean     @default(false) @map("db_enabled")
  dbName          String?     @map("db_name") @db.VarChar(63)
  dbUser          String?     @map("db_user") @db.VarChar(63)
  dbPasswordEnc   String?     @map("db_password_enc") @db.Text
  redisEnabled    Boolean     @default(false) @map("redis_enabled")
  redisDbNumber   Int?        @map("redis_db_number")
  mariadbEnabled  Boolean     @default(false) @map("mariadb_enabled")
  mariadbName     String?     @map("mariadb_name") @db.VarChar(63)
  mariadbUser     String?     @map("mariadb_user") @db.VarChar(63)
  mariadbPasswordEnc String?  @map("mariadb_password_enc") @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments   Deployment[]
  backups       Backup[]

  @@unique([userId, name])
  @@map("projects")
}

enum DeploymentStatus {
  QUEUED
  CLONING
  BUILDING
  DEPLOYING
  LIVE
  FAILED
  STOPPED

  @@map("deployment_status")
}

model Deployment {
  id            String           @id @default(uuid())
  projectId     String           @map("project_id")
  status        DeploymentStatus @default(QUEUED)
  commitHash    String?          @map("commit_hash") @db.VarChar(40)
  dockerImageId String?          @map("docker_image_id") @db.VarChar(100)
  containerId   String?          @map("container_id") @db.VarChar(100)
  containerPort Int?             @map("container_port")
  // Port the app listens on INSIDE the container (80 for nginx-served builds); needed to rollback
  internalPort  Int?             @map("internal_port")
  rollbackOf    String?          @map("rollback_of")
  startedAt     DateTime         @default(now()) @map("started_at")
  finishedAt    DateTime?        @map("finished_at")
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs          Log[]

  @@map("deployments")
}

enum LogType {
  BUILD
  RUNTIME
  SYSTEM

  @@map("log_type")
}

model Log {
  id           String     @id @default(uuid())
  deploymentId String     @map("deployment_id")
  type         LogType
  message      String     @db.Text
  timestamp    DateTime   @default(now())
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, timestamp])
  @@map("logs")
}

model PlatformSettings {
  id             String    @id @default("singleton")
  setupCompleted Boolean   @default(false) @map("setup_completed")
  baseDomain     String?   @map("base_domain") @db.VarChar(255)
  adminEmail     String?   @map("admin_email") @db.VarChar(255)
  sslEnabled     Boolean   @default(false) @map("ssl_enabled")
  installedAt    DateTime? @map("installed_at")
  platformName   String    @default("CloudDabba") @map("platform_name") @db.VarChar(100)
  corsOrigins    String?   @map("cors_origins") @db.Text
  allowSignup    Boolean   @default(true) @map("allow_signup")
  sslEmail       String?   @map("ssl_email") @db.VarChar(255)
  defaultBranch  String    @default("main") @map("default_branch") @db.VarChar(100)
  cloudflareApiTokenEnc String? @map("cloudflare_api_token_enc") @db.Text
  // Notifications (secrets encrypted at rest)
  notifyWebhookUrlEnc   String? @map("notify_webhook_url_enc") @db.Text
  notifyTelegramTokenEnc String? @map("notify_telegram_token_enc") @db.Text
  notifyTelegramChatId  String? @map("notify_telegram_chat_id") @db.VarChar(64)
  notifyEmail           String? @map("notify_email") @db.VarChar(255)
  notifyEvents          Json?   @map("notify_events")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model StorageCleanupLog {
  id             String   @id @default(uuid())
  trigger        String   @db.VarChar(20)  // AUTO | MANUAL
  level          String   @db.VarChar(20)  // WARNING | CLEANUP | EMERGENCY | SAFE
  status         String   @db.VarChar(20)  // SUCCESS | SKIPPED | FAILED
  usageBefore    Float    @map("usage_before")
  usageAfter     Float?   @map("usage_after")
  bytesReclaimed BigInt   @default(0) @map("bytes_reclaimed")
  imagesRemoved  Int      @default(0) @map("images_removed")
  details        String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("storage_cleanup_logs")
}

model Backup {
  id         String   @id @default(uuid())
  scope      String   @db.VarChar(10)   // PROJECT | PLATFORM
  projectId  String?  @map("project_id")
  engine     String   @db.VarChar(10)   // POSTGRES | MARIADB
  trigger    String   @db.VarChar(12)   // AUTO | MANUAL | PRE_RESTORE
  status     String   @db.VarChar(10)   // RUNNING | SUCCESS | FAILED
  fileName   String?  @map("file_name") @db.VarChar(120)
  sizeBytes  BigInt   @default(0) @map("size_bytes")
  error      String?  @db.Text
  createdBy  String?  @map("created_by") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([scope, createdAt])
  @@map("backups")
}

model AuditLog {
  id              String   @id @default(uuid())
  actorId         String?  @map("actor_id")
  actorEmail      String?  @map("actor_email") @db.VarChar(255)
  impersonatedBy  String?  @map("impersonated_by") @db.VarChar(255)
  action          String   @db.VarChar(60)
  targetType      String?  @map("target_type") @db.VarChar(30)
  targetId        String?  @map("target_id") @db.VarChar(64)
  targetLabel     String?  @map("target_label") @db.VarChar(255)
  ip              String?  @db.VarChar(64)
  meta            Json?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
