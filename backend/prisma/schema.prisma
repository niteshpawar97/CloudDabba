generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique @db.VarChar(255)
  password           String    @db.VarChar(255)
  name               String    @db.VarChar(100)
  role               String    @default("user") @db.VarChar(20)
  githubPatEncrypted String?   @map("github_pat_encrypted") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  projects           Project[]

  @@map("users")
}

enum ProjectType {
  NODE_BACKEND
  REACT_FRONTEND
  NEXTJS_APP
  STATIC_SITE
  FULLSTACK
  CUSTOM_DOCKERFILE

  @@map("project_type")
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
  FAILED
  BUILDING

  @@map("project_status")
}

model Project {
  id            String        @id @default(uuid())
  userId        String        @map("user_id")
  name          String        @db.VarChar(100)
  repoUrl       String        @map("repo_url") @db.VarChar(500)
  subdomain     String        @unique @db.VarChar(63)
  projectType   ProjectType   @map("project_type")
  status        ProjectStatus @default(INACTIVE)
  branch        String        @default("main") @db.VarChar(100)
  envVars       Json?         @map("env_vars")
  autoDeploy    Boolean       @default(false) @map("auto_deploy")
  webhookSecret String?       @map("webhook_secret") @db.VarChar(64)
  customDomain  String?       @unique @map("custom_domain") @db.VarChar(255)
  domainVerified Boolean      @default(false) @map("domain_verified")
  // Database provisioning
  dbEnabled       Boolean     @default(false) @map("db_enabled")
  dbName          String?     @map("db_name") @db.VarChar(63)
  dbUser          String?     @map("db_user") @db.VarChar(63)
  dbPasswordEnc   String?     @map("db_password_enc") @db.Text
  redisEnabled    Boolean     @default(false) @map("redis_enabled")
  redisDbNumber   Int?        @map("redis_db_number")
  mariadbEnabled  Boolean     @default(false) @map("mariadb_enabled")
  mariadbName     String?     @map("mariadb_name") @db.VarChar(63)
  mariadbUser     String?     @map("mariadb_user") @db.VarChar(63)
  mariadbPasswordEnc String?  @map("mariadb_password_enc") @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deployments   Deployment[]

  @@unique([userId, name])
  @@map("projects")
}

enum DeploymentStatus {
  QUEUED
  CLONING
  BUILDING
  DEPLOYING
  LIVE
  FAILED
  STOPPED

  @@map("deployment_status")
}

model Deployment {
  id            String           @id @default(uuid())
  projectId     String           @map("project_id")
  status        DeploymentStatus @default(QUEUED)
  commitHash    String?          @map("commit_hash") @db.VarChar(40)
  dockerImageId String?          @map("docker_image_id") @db.VarChar(100)
  containerId   String?          @map("container_id") @db.VarChar(100)
  containerPort Int?             @map("container_port")
  startedAt     DateTime         @default(now()) @map("started_at")
  finishedAt    DateTime?        @map("finished_at")
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs          Log[]

  @@map("deployments")
}

enum LogType {
  BUILD
  RUNTIME
  SYSTEM

  @@map("log_type")
}

model Log {
  id           String     @id @default(uuid())
  deploymentId String     @map("deployment_id")
  type         LogType
  message      String     @db.Text
  timestamp    DateTime   @default(now())
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@index([deploymentId, timestamp])
  @@map("logs")
}

model PlatformSettings {
  id             String    @id @default("singleton")
  setupCompleted Boolean   @default(false) @map("setup_completed")
  baseDomain     String?   @map("base_domain") @db.VarChar(255)
  adminEmail     String?   @map("admin_email") @db.VarChar(255)
  sslEnabled     Boolean   @default(false) @map("ssl_enabled")
  installedAt    DateTime? @map("installed_at")
  platformName   String    @default("CloudDabba") @map("platform_name") @db.VarChar(100)
  corsOrigins    String?   @map("cors_origins") @db.Text
  allowSignup    Boolean   @default(true) @map("allow_signup")
  sslEmail       String?   @map("ssl_email") @db.VarChar(255)
  defaultBranch  String    @default("main") @map("default_branch") @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("platform_settings")
}
