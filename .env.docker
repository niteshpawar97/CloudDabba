# CloudDabba Docker Configuration
# Copy this to .env and customize before running: docker compose -f docker-compose.prod.yml up -d

# Database
DB_USER=clouddabba
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=clouddabba

# Security (generate with: openssl rand -base64 48)
JWT_SECRET=CHANGE_ME_JWT_SECRET
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_64_CHAR_HEX_STRING

# Domain (your platform domain)
BASE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:6050

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# App port (exposed on host)
APP_PORT=6050

# Database provisioning (host IP from container perspective)
PROVISION_DB_HOST=172.17.0.1
